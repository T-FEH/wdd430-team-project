# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# Clerk keys from https://dashboard.clerk.com > your app > API keys.
# In development you can leave these empty: Clerk runs in keyless mode and
# shows a banner where you can claim the temporary app.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Public URL of the deployed site, used for canonical links, Open Graph, and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
